{
  "name": "@linkedmink/eip-4361-parser",
  "version": "2.0.0-0",
  "description": "Handle EIP-4361 messages to Sign in with Ethereum on both the client and server",
  "keywords": [
    "EIP-4361",
    "Ethereum",
    "Authentication"
  ],
  "homepage": "https://github.com/LinkedMink/eip-4361-parser#readme",
  "bugs": {
    "url": "https://github.com/LinkedMink/eip-4361-parser/issues",
    "email": "harlan.sang@linkedmink.net"
  },
  "license": "MIT",
  "author": {
    "name": "Harlan Sang",
    "email": "harlan.sang@linkedmink.net",
    "url": "https://github.com/LinkedMink"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/LinkedMink"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod": {
      "import": "./dist/zod/index.js",
      "types": "./dist/zod/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinkedMink/eip-4361-parser.git"
  },
  "scripts": {
    "prebuild": "node node_modules/apg-js/bin/apg.sh --lite -i src/grammar/eip4361.abnf -o src/grammar/eip4361.js",
    "build": "tsc --project src/tsconfig.json",
    "clean": "node -e \"fs.rm('dist', { force: true, recursive: true }, () => {}); fs.rm('coverage', { force: true, recursive: true }, () => {})\"",
    "lint": "eslint {src,test}/**/*.ts *.js",
    "test": "jest --reporters default --watch",
    "test:ci": "jest --coverage --ci",
    "test:debug": "jest --reporters default --detectOpenHandles --watch",
    "preversion": "concurrently -c auto npm:build npm:lint npm:test:ci",
    "version": "git add .",
    "postversion": "node -e \"import('./package.json', {with: {type: 'json'}}).then((p) => process.exit(p.default.version.includes('-') ? 1 : 0))\" || npm publish --tag dev",
    "version:prerelease": "npm --no-git-tag-version version prerelease",
    "prepack": "npm run clean && npm run build",
    "prepare": "husky || cd ."
  },
  "dependencies": {
    "apg-lite": "^1.0.4"
  },
  "peerDependencies": {
    "ethers": ">= 6.13.0",
    "zod": ">= 4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.0.5",
    "@linkedmink/eslint-config": "^1.0.2",
    "@swc/jest": "^0.2.37",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.3",
    "apg-js": "^4.4.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "ethers": "^6.13.2",
    "husky": "^9.1.4",
    "jest": "^30.0.5",
    "jest-mock-extended": "^4.0.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.3.3",
    "tsx": "^4.16.3",
    "type-fest": "^5.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "zod": "^4.0.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "@swc/core@1.15.46": true
  }
}
